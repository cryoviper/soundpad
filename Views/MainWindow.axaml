<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BoomBx.ViewModels"
        xmlns:views="using:BoomBx.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="using:BoomBx.Converters"
        mc:Ignorable="d"
        x:Class="BoomBx.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        xmlns:model="using:BoomBx.Models"
        xmlns:sys="using:System"
        Icon="/Assets/logo.png"
        Title="Boobies Soundpad"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        CanResize="True"
        Width="1280"
        Height="820"
        MinWidth="1080"
        MinHeight="700">

    <Window.Resources>
        <conv:UriToImageSourceConverter x:Key="UriConverter"/>

        <!-- Sound tiles: clear hover + selected state -->
        <ControlTheme x:Key="TileItemTheme" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0 0 12 12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="tile"
                            Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#tile">
                <Setter Property="Background" Value="{StaticResource Surface3Brush}"/>
            </Style>
            <Style Selector="^:selected /template/ Border#tile">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Background" Value="#2A1F28"/>
            </Style>
        </ControlTheme>

        <!-- Soundboard list rows -->
        <ControlTheme x:Key="BoardItemTheme" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12 9"/>
            <Setter Property="Margin" Value="0 1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="row" Background="Transparent" CornerRadius="8">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#row">
                <Setter Property="Background" Value="#1C1C22"/>
            </Style>
            <Style Selector="^:selected /template/ Border#row">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
        </ControlTheme>
        <!-- One YouTube result row (used by Results and Recently played) -->
        <DataTemplate x:Key="YtRowTemplate" DataType="model:YouTubeResult">
            <Border Classes="yt-row" Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="14" Padding="10">
                <Border.Styles>
                    <Style Selector="Border.yt-row:pointerover">
                        <Setter Property="Background" Value="{StaticResource Surface3Brush}"/>
                    </Style>
                </Border.Styles>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="144" Height="81" CornerRadius="10" ClipToBounds="True"
                            Background="{StaticResource Surface3Brush}">
                        <Panel>
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                            <Border Background="#CC000000" CornerRadius="5" Padding="6 2"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                    IsVisible="{Binding DurationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding DurationText}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                        </Panel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16 0" VerticalAlignment="Center" Spacing="5">
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}"
                                   FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Channel}" Classes="value" TextTrimming="CharacterEllipsis"/>
                        <Border IsVisible="{Binding IsPlaying}" HorizontalAlignment="Left"
                                Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="8 2">
                            <TextBlock Text="PLAYING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0 0 6 0">
                        <Button Tag="{Binding}" Classes="yt-save icon round" ToolTip.Tip="Save as MP3 + add to board">
                            <PathIcon Data="{StaticResource IconDownload}" Width="15" Height="15"/>
                        </Button>
                        <Button Tag="{Binding}" Classes="yt-pin icon round" ToolTip.Tip="Pin to board (streams live)">
                            <PathIcon Data="{StaticResource IconPin}" Width="15" Height="15"/>
                        </Button>
                        <Button Tag="{Binding}" Classes="yt-play icon accent round" ToolTip.Tip="Play in your mic">
                            <PathIcon Data="{StaticResource IconPlay}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- Play icon that fades in when hovering a sound tile -->
        <Style Selector="Border.play-hint">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.play-hint">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="232,Auto,*,Auto">

            <!-- ================= Sidebar ================= -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0 0 1 0">
                <DockPanel Margin="14 18">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="6 0 0 26">
                        <Image Source="/Assets/logo.png" Width="40" Height="40"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Boobies" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="SOUNDPAD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding AppVersion}" Classes="label" Margin="12 0"/>

                    <StackPanel Spacing="2">
                        <RadioButton x:Name="SoundsNav" GroupName="Nav" Classes="SidebarButton"
                                     Tag="{x:Static views:NavigationItem.Sounds}" IsChecked="True">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconGrid}"/>
                                <TextBlock Text="Sounds" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="YouTubeNav" GroupName="Nav" Classes="SidebarButton"
                                     Tag="{x:Static views:NavigationItem.YouTube}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconLive}"/>
                                <TextBlock Text="YouTube Live" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TextToSpeechNav" GroupName="Nav" Classes="SidebarButton"
                                     Tag="{x:Static views:NavigationItem.TextToSpeech}"
                                     Checked="TextToSpeechNav_Checked">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconChat}"/>
                                <TextBlock Text="Text to Speech" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="VoiceChangerNav" GroupName="Nav" Classes="SidebarButton"
                                     Tag="{x:Static views:NavigationItem.VoiceChanger}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconMic}"/>
                                <TextBlock Text="Voice Changer" VerticalAlignment="Center"/>
                                <Border IsVisible="{Binding VoiceEnabled}" Background="{StaticResource AccentBrush}"
                                        CornerRadius="5" Padding="5 1" VerticalAlignment="Center">
                                    <TextBlock Text="ON" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="SettingsNav" GroupName="Nav" Classes="SidebarButton"
                                     Tag="{x:Static views:NavigationItem.Settings}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{StaticResource IconTune}"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ================= Soundboards (Sounds tab only) ================= -->
            <Border Grid.Column="1" Width="220"
                    IsVisible="{Binding #SoundsNav.IsChecked}"
                    Background="{StaticResource Surface1Brush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0 0 1 0">
                <DockPanel Margin="14 22">
                    <TextBlock DockPanel.Dock="Top" Text="SOUNDBOARDS" Classes="label" Margin="10 0 0 10"/>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0 12 0 0">
                        <Button Classes="icon small" Click="AddSoundboard" ToolTip.Tip="New soundboard">
                            <PathIcon Data="{StaticResource IconPlus}"/>
                        </Button>
                        <Button Classes="icon small" Click="RenameSoundboard" ToolTip.Tip="Rename">
                            <PathIcon Data="{StaticResource IconEdit}" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="icon small danger" Click="RemoveSoundboard" ToolTip.Tip="Delete">
                            <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Soundboards}"
                             SelectionChanged="SoundboardList_SelectionChanged"
                             SelectedItem="{Binding SelectedSoundboard, Mode=TwoWay}"
                             ItemContainerTheme="{StaticResource BoardItemTheme}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ================= Main content ================= -->
            <ScrollViewer Grid.Column="2">
                <StackPanel x:Name="MainUI" IsVisible="False" Margin="32 28" MaxWidth="1000" Spacing="20">

                    <!-- ===== Sounds ===== -->
                    <Border x:Name="SoundsDropZone" Background="Transparent" IsVisible="{Binding #SoundsNav.IsChecked}">
                    <StackPanel Spacing="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding SelectedSoundboard.Name}" Classes="h1"/>
                                <TextBlock Text="Click a sound, then Play. Right-click for more. Drop audio files here to add them." Classes="sub"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="danger" Click="RemoveFromLibrary">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14"/>
                                        <TextBlock Text="Remove"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="accent" Click="AddToLibrary">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14"/>
                                        <TextBlock Text="Add sound"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Search in board -->
                        <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="6" MaxWidth="420" HorizontalAlignment="Left">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon Data="{StaticResource IconSearch}" Foreground="{StaticResource FaintBrush}"
                                          Width="16" Height="16" Margin="8 0 4 0"/>
                                <TextBox Grid.Column="1" Classes="bare" Width="360"
                                         Text="{Binding SoundFilter, Mode=TwoWay}" Watermark="Find a sound..."/>
                            </Grid>
                        </Border>

                        <!-- Empty board -->
                        <Border Classes="card" Padding="36" IsVisible="{Binding BoardIsEmpty}">
                            <StackPanel HorizontalAlignment="Center" Spacing="10">
                                <PathIcon Data="{StaticResource IconMusic}" Width="34" Height="34"
                                          Foreground="{StaticResource FaintBrush}"/>
                                <TextBlock Text="No sounds yet" Classes="h2" HorizontalAlignment="Center"/>
                                <TextBlock Text="Drag MP3 / WAV / M4A files here, click Add sound, or pin clips from YouTube Live."
                                           Classes="sub" TextAlignment="Center" MaxWidth="360"/>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="SoundsList"
                                 SelectionMode="Single"
                                 ItemsSource="{Binding FilteredSounds}"
                                 SelectedItem="{Binding SelectedSound, Mode=TwoWay}"
                                 ItemContainerTheme="{StaticResource TileItemTheme}">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Play" Click="CtxPlay_Click">
                                        <MenuItem.Icon><PathIcon Data="{StaticResource IconPlay}" Width="12" Height="12"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Set hotkey..." Click="CtxHotkey_Click">
                                        <MenuItem.Icon><PathIcon Data="{StaticResource IconKeyboard}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Show file / open on YouTube" Click="CtxShowFile_Click">
                                        <MenuItem.Icon><PathIcon Data="{StaticResource IconLink}" Width="12" Height="12"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Remove" Click="RemoveFromLibrary">
                                        <MenuItem.Icon><PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="model:SoundItem">
                                    <Panel>
                                        <StackPanel Width="150" Spacing="10" Margin="14 16">
                                            <Panel Width="72" Height="72" HorizontalAlignment="Center">
                                                <Border CornerRadius="12" ClipToBounds="True" Background="{StaticResource Surface3Brush}">
                                                    <Image Source="{Binding IconPath, Converter={StaticResource UriConverter}}"
                                                           Stretch="UniformToFill"/>
                                                </Border>
                                                <Border Classes="play-hint" Background="#99000000" CornerRadius="12">
                                                    <Border.Transitions>
                                                        <Transitions>
                                                            <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                                                        </Transitions>
                                                    </Border.Transitions>
                                                    <PathIcon Data="{StaticResource IconPlay}" Width="22" Height="22" Foreground="White"
                                                              ToolTip.Tip="Double-click to play"/>
                                                </Border>
                                                <Border IsVisible="{Binding IsYouTube}"
                                                        Background="{StaticResource AccentBrush}" CornerRadius="6"
                                                        Padding="5 1" Margin="0 0 -6 -6"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                    <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </Panel>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border IsVisible="{Binding HasHotkey}" Background="{StaticResource Surface4Brush}"
                                                CornerRadius="6" Padding="6 2" Margin="8"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Hotkey}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </Border>
                                    </Panel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    </Border>

                    <!-- ===== YouTube Live ===== -->
                    <StackPanel Spacing="18" IsVisible="{Binding #YouTubeNav.IsChecked}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="YouTube Live" Classes="h1"/>
                            <TextBlock Text="Search any sound or song and play it straight into your mic. Trim it, pin it, or save it as MP3." Classes="sub"/>
                        </StackPanel>

                        <!-- Search bar -->
                        <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Data="{StaticResource IconSearch}" Foreground="{StaticResource FaintBrush}"
                                          Width="18" Height="18" Margin="10 0 6 0"/>
                                <TextBox x:Name="YtSearchBox" Grid.Column="1" Classes="bare"
                                         Text="{Binding YtQuery, Mode=TwoWay}"
                                         Watermark="Search YouTube or paste a link..."
                                         FontSize="15"/>
                                <Button Grid.Column="2" Classes="accent" Click="YtSearch_Click"
                                        IsEnabled="{Binding !YtIsSearching}" Padding="22 10">
                                    <TextBlock Text="Search"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Status -->
                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding YtStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center" Margin="2 0 10 0"/>
                            <TextBlock Grid.Column="1" Text="{Binding YtStatus}" Classes="sub"/>
                        </Grid>
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding YtIsSearching}" Height="3" MinHeight="3"/>

                        <!-- Now playing -->
                        <Border Classes="card" Padding="18"
                                IsVisible="{Binding YtNowPlaying, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="160" Height="90" CornerRadius="10" ClipToBounds="True"
                                            Background="{StaticResource Surface3Brush}" VerticalAlignment="Top">
                                        <Image Source="{Binding YtNowPlaying.Thumbnail}" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18 2 0 0" Spacing="8">
                                        <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="{Binding YtNowPlayingTitle}" Classes="h2"
                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Text="{Binding YtElapsedText}" Classes="value" Width="44" VerticalAlignment="Center"/>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <Slider x:Name="YtSeekSlider" Minimum="0" Maximum="1"
                                                        IsVisible="{Binding !YtIsLoading}" ToolTip.Tip="Drag to jump"/>
                                                <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4"
                                                             IsVisible="{Binding YtIsLoading}"/>
                                            </Panel>
                                            <TextBlock Grid.Column="2" Text="{Binding YtTotalText}" Classes="value"
                                                       Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Controls -->
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                    <Button Classes="icon accent round" Click="YtPlayPause_Click" ToolTip.Tip="Play / pause">
                                        <Panel>
                                            <PathIcon Data="{StaticResource IconPause}" IsVisible="{Binding YtIsPlaying}"/>
                                            <PathIcon Data="{StaticResource IconPlay}" IsVisible="{Binding !YtIsPlaying}"/>
                                        </Panel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="icon round" Margin="8 0 0 0"
                                            Click="YtStop_Click" ToolTip.Tip="Stop">
                                        <PathIcon Data="{StaticResource IconStop}" Width="14" Height="14"/>
                                    </Button>
                                    <Grid Grid.Column="2" ColumnDefinitions="Auto,*,Auto" Margin="20 0" MaxWidth="280"
                                          HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconVolume}" Foreground="{StaticResource MutedBrush}"
                                                  Width="18" Height="18"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Width="170"
                                                Value="{Binding YtVolume, Mode=TwoWay}" Margin="10 0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding YtVolume, StringFormat='{}{0:F0}%'}"
                                                   Classes="value" Width="36" VerticalAlignment="Center"/>
                                    </Grid>
                                    <CheckBox Grid.Column="3" Content="Loop" IsChecked="{Binding IsLoopingEnabled}"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Clip trimmer -->
                                <Border Background="{StaticResource Surface1Brush}" CornerRadius="12" Padding="14">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="CUT A CLIP" Classes="label" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Play, then mark where the clip starts and ends"
                                                       Classes="value" FontSize="11"/>
                                        </Grid>
                                        <WrapPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 0 12 8">
                                                <TextBlock Text="Start" Classes="value" VerticalAlignment="Center"/>
                                                <TextBox Width="72" Text="{Binding YtStartText, Mode=TwoWay}" Watermark="0:00"/>
                                                <Button Click="YtMarkStart_Click" ToolTip.Tip="Use the current play position">
                                                    <TextBlock Text="Mark now"/>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 0 12 8">
                                                <TextBlock Text="End" Classes="value" VerticalAlignment="Center"/>
                                                <TextBox Width="72" Text="{Binding YtEndText, Mode=TwoWay}" Watermark="end"/>
                                                <Button Click="YtMarkEnd_Click" ToolTip.Tip="Use the current play position">
                                                    <TextBlock Text="Mark now"/>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 0 0 8">
                                                <Button Click="YtPreviewClip_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <PathIcon Data="{StaticResource IconPlay}" Width="12" Height="12"/>
                                                        <TextBlock Text="Preview clip"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Classes="ghost" Click="YtClearClip_Click">
                                                    <TextBlock Text="Reset"/>
                                                </Button>
                                            </StackPanel>
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Click="YtPinNowPlaying_Click"
                                                    ToolTip.Tip="Add to your soundboard. Streams from YouTube, takes no space.">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="{StaticResource IconPin}" Width="14" Height="14"/>
                                                    <TextBlock Text="Pin to board"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="accent" Click="YtSaveNowPlaying_Click" IsEnabled="{Binding !YtIsSaving}"
                                                    ToolTip.Tip="Save as an MP3 file and add it to your board. Works offline.">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="{StaticResource IconDownload}" Width="14" Height="14"/>
                                                    <TextBlock Text="Save MP3"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="ghost" Click="OpenDownloadFolderFromYt_Click">
                                                <TextBlock Text="Open folder" FontWeight="Normal"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Empty state with quick ideas -->
                        <StackPanel Spacing="10" IsVisible="{Binding !YtHasResults}">
                            <TextBlock Text="TRY ONE" Classes="label"/>
                            <WrapPanel>
                                <Button Classes="chip" Tag="vine boom sound effect" Click="YtChip_Click" Content="Vine boom"/>
                                <Button Classes="chip" Tag="bruh sound effect" Click="YtChip_Click" Content="Bruh"/>
                                <Button Classes="chip" Tag="air horn sound effect" Click="YtChip_Click" Content="Air horn"/>
                                <Button Classes="chip" Tag="sad violin meme sound" Click="YtChip_Click" Content="Sad violin"/>
                                <Button Classes="chip" Tag="fart sound effect" Click="YtChip_Click" Content="Fart"/>
                                <Button Classes="chip" Tag="emotional damage sound effect" Click="YtChip_Click" Content="Emotional damage"/>
                                <Button Classes="chip" Tag="hosh mein aao abhijeet sound effect" Click="YtChip_Click" Content="Hosh mein aao"/>
                                <Button Classes="chip" Tag="bhai kya kar raha hai tu meme sound" Click="YtChip_Click" Content="Bhai kya kar raha hai"/>
                                <Button Classes="chip" Tag="dramatic sound effect" Click="YtChip_Click" Content="Dramatic"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Results -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding YtHasResults}">
                            <TextBlock Text="RESULTS" Classes="label" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="ghost" Click="YtClearResults_Click" Padding="8 4">
                                <TextBlock Text="Clear" FontWeight="Normal" FontSize="12"/>
                            </Button>
                        </Grid>
                        <ItemsControl x:Name="YtResultsList" ItemsSource="{Binding YtResults}"
                                      ItemTemplate="{StaticResource YtRowTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Recently played -->
                        <StackPanel Spacing="10" IsVisible="{Binding YtHasRecent}">
                            <TextBlock Text="RECENTLY PLAYED" Classes="label" IsVisible="{Binding !YtHasResults}"/>
                            <ItemsControl x:Name="YtRecentList" ItemsSource="{Binding YtRecent}"
                                          ItemTemplate="{StaticResource YtRowTemplate}"
                                          IsVisible="{Binding !YtHasResults}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- ===== Text to Speech ===== -->
                    <StackPanel Spacing="20" IsVisible="{Binding #TextToSpeechNav.IsChecked}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Text to Speech" Classes="h1"/>
                            <TextBlock Text="Natural voices in Hindi, English and 100+ languages, spoken straight into your mic. Ctrl+Enter to speak."
                                       Classes="sub"/>
                        </StackPanel>

                        <Border Classes="card">
                            <StackPanel Spacing="18">
                                <Grid ColumnDefinitions="*,14,*">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="LANGUAGE" Classes="label"/>
                                        <ComboBox ItemsSource="{Binding TtsLanguages}"
                                                  SelectedItem="{Binding TtsSelectedLanguage, Mode=TwoWay}"
                                                  MaxDropDownHeight="420"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6">
                                        <TextBlock Text="VOICE" Classes="label"/>
                                        <ComboBox ItemsSource="{Binding TtsVoices}"
                                                  SelectedItem="{Binding TtsSelectedVoice, Mode=TwoWay}"
                                                  MaxDropDownHeight="420">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate DataType="model:TtsVoice">
                                                    <TextBlock Text="{Binding Display}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBox x:Name="TtsTextBox"
                                         Text="{Binding TtsText, Mode=TwoWay}"
                                         Watermark="Type in any language... e.g. नमस्ते दोस्तों, कैसे हो?"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         MaxLength="2000"
                                         Height="120"/>

                                <Grid ColumnDefinitions="*,24,*,24,*">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="SPEED" Classes="label"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TtsRate, StringFormat='{}{0:+0;-0;0}%'}" Classes="value"/>
                                        </Grid>
                                        <Slider Minimum="-50" Maximum="100" SmallChange="5" LargeChange="10"
                                                Value="{Binding TtsRate, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="PITCH" Classes="label"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TtsPitchHz, StringFormat='{}{0:+0;-0;0} Hz'}" Classes="value"/>
                                        </Grid>
                                        <Slider Minimum="-50" Maximum="50" SmallChange="5" LargeChange="10"
                                                Value="{Binding TtsPitchHz, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="VOLUME" Classes="label"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TtsVolume, StringFormat='{}{0:F0}%'}" Classes="value"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="100" Value="{Binding TtsVolume, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                    <Button Classes="accent" Click="PreviewTts_Click" Padding="20 10" IsEnabled="{Binding !TtsBusy}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource IconPlay}" Width="14" Height="14"/>
                                            <TextBlock Text="Speak"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="icon" Margin="8 0 0 0" Click="TtsStop_Click" ToolTip.Tip="Stop">
                                        <PathIcon Data="{StaticResource IconStop}" Width="14" Height="14"/>
                                    </Button>
                                    <Button Grid.Column="2" Margin="8 0 0 0" Click="SaveTtsAudio_Click" IsEnabled="{Binding !TtsBusy}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource IconSave}" Width="14" Height="14"/>
                                            <TextBlock Text="Save to soundboard"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="4" Classes="ghost" Click="TtsReset_Click">
                                        <TextBlock Text="Reset speed/pitch" FontWeight="Normal"/>
                                    </Button>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding TtsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                                             VerticalAlignment="Center" Margin="2 0 10 0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TtsStatus}" Classes="sub"/>
                                </Grid>
                                <ProgressBar IsIndeterminate="True" IsVisible="{Binding TtsBusy}" Height="3" MinHeight="3"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="10" IsVisible="{Binding TtsHasRecent}">
                            <TextBlock Text="SAID RECENTLY" Classes="label"/>
                            <ItemsControl x:Name="TtsRecentList" ItemsSource="{Binding TtsRecent}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sys:String">
                                        <Button Classes="chip tts-recent" Tag="{Binding}" MaxWidth="320">
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- ===== Voice Changer ===== -->
                    <StackPanel Spacing="20" IsVisible="{Binding #VoiceChangerNav.IsChecked}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Voice Changer" Classes="h1"/>
                            <TextBlock Text="Changes your real mic live, in Discord and games. Pick a voice and talk." Classes="sub"/>
                        </StackPanel>

                        <!-- On/off + status -->
                        <Border Classes="card" Padding="18">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentSoftBrush}">
                                    <PathIcon Data="{StaticResource IconMic}" Width="20" Height="20" Foreground="{StaticResource AccentBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14 0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="h2">
                                        <Run Text="Voice: "/>
                                        <Run Text="{Binding SelectedVoiceCard.Name}" Foreground="{StaticResource AccentBrush}"/>
                                    </TextBlock>
                                    <TextBlock Classes="value">
                                        <Run Text="Toggle anywhere with "/>
                                        <Run Text="{Binding VoiceToggleHotkey}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsChecked="{Binding VoiceEnabled}"
                                              OnContent="ON" OffContent="OFF" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Presets -->
                        <TextBlock Text="VOICES" Classes="label"/>
                        <ListBox x:Name="VoiceCardsList"
                                 ItemsSource="{Binding VoiceCards}"
                                 SelectedItem="{Binding SelectedVoiceCard, Mode=TwoWay}"
                                 ItemContainerTheme="{StaticResource TileItemTheme}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="model:VoicePresetCard">
                                    <StackPanel Width="164" Margin="16 16" Spacing="10">
                                        <Border Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Left"
                                                Background="{Binding Color}">
                                            <TextBlock Text="{Binding Letter}" FontSize="18" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{Binding Description}" Classes="value" FontSize="11"
                                                       TextWrapping="Wrap" MaxLines="2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Tuning -->
                        <Border Classes="card">
                            <StackPanel Spacing="18">
                                <Grid ColumnDefinitions="*,24,*">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBlock Text="FINE-TUNE PITCH" Classes="label" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding VoicePitchTune, StringFormat='{}{0:+0;-0;0} steps'}"
                                                       Classes="value" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Classes="ghost" Padding="8 2" Margin="6 0 0 0"
                                                    Click="VoiceResetPitch_Click">
                                                <TextBlock Text="Reset" FontSize="11" FontWeight="Normal"/>
                                            </Button>
                                        </Grid>
                                        <Slider Minimum="-6" Maximum="6" SmallChange="1" LargeChange="1"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding VoicePitchTune, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6">
                                        <TextBlock Text="YOUR MIC LEVEL" Classes="label"/>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding MicMeter}"
                                                     Height="8" MinHeight="8" Margin="0 8 0 0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Hear myself" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="Plays your changed voice in your headphones so you can test it. Use headphones, not speakers (echo)."
                                                   Classes="value" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding MonitorEnabled}"
                                                  OnContent="ON" OffContent="OFF" Margin="16 0 0 0"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Text="Voice changer on/off hotkey" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBox Grid.Column="1" Name="VoiceToggleHotkeyTextBox" Width="140"
                                             Text="{Binding VoiceToggleHotkey, Mode=OneWay}" IsReadOnly="True"/>
                                    <Button Grid.Column="2" Content="Change" Margin="8 0 0 0"
                                            Click="SetHotkey_Click" Tag="{Binding #VoiceToggleHotkeyTextBox}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Settings ===== -->
                    <StackPanel Spacing="20" IsVisible="{Binding #SettingsNav.IsChecked}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Settings" Classes="h1"/>
                            <TextBlock Text="Playback = CABLE Input. In Discord or your game, pick CABLE Output as the microphone." Classes="sub"/>
                        </StackPanel>

                        <Border Classes="card">
                            <StackPanel Spacing="18">
                                <TextBlock Text="Devices" Classes="h2"/>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="PLAYBACK DEVICE (VIRTUAL MIC)" Classes="label"/>
                                    <ComboBox x:Name="PlaybackComboBox"
                                              ItemsSource="{Binding PlaybackDevices}"
                                              SelectedItem="{Binding SelectedPlaybackDevice}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FriendlyName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="YOUR MICROPHONE" Classes="label"/>
                                    <ComboBox x:Name="CaptureComboBox"
                                              ItemsSource="{Binding CaptureDevices}"
                                              SelectedItem="{Binding SelectedCaptureDevice}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FriendlyName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Mic -->
                        <Border Classes="card">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Your mic" Classes="h2"/>
                                        <TextBlock Text="Noise gate mutes your mic between words, so games don't hear hiss or fan noise."
                                                   Classes="sub" FontSize="12"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Content="Mute my mic" IsChecked="{Binding MicMuted}"
                                              VerticalAlignment="Top"/>
                                </Grid>

                                <!-- Meter with gate marker -->
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="LEVEL (TALK TO TEST)" Classes="label"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{StaticResource AccentBrush}" IsVisible="{Binding MicGateOpen}"/>
                                            <TextBlock Text="sending" Classes="value" FontSize="11" IsVisible="{Binding MicGateOpen}"/>
                                            <TextBlock Text="gated (silent)" Classes="value" FontSize="11" IsVisible="{Binding !MicGateOpen}"/>
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding MicMeter}" Height="8" MinHeight="8"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,24,*">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <CheckBox Content="Noise gate" IsChecked="{Binding NoiseGateEnabled}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding NoiseGateDb, StringFormat='{}{0:F0} dB'}"
                                                       Classes="value" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Slider Minimum="-80" Maximum="-10" Value="{Binding NoiseGateDb, Mode=TwoWay}"
                                                IsEnabled="{Binding NoiseGateEnabled}"
                                                ToolTip.Tip="Move right until the meter says 'gated' when you're quiet and 'sending' when you talk"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="MIC VOLUME" Classes="label" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MicVolume, StringFormat='{}{0:F0}%'}" Classes="value"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="150" Value="{Binding MicVolume, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Sound volumes -->
                        <Border Classes="card">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Sound volume" Classes="h2"/>
                                <Grid ColumnDefinitions="*,24,*">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="FRIENDS HEAR" Classes="label"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MasterVirtualVolume, StringFormat='{}{0:F0}%'}" Classes="value"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="100" Value="{Binding MasterVirtualVolume, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="YOU HEAR" Classes="label"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MasterSpeakerVolume, StringFormat='{}{0:F0}%'}" Classes="value"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="100" Value="{Binding MasterSpeakerVolume, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Downloads -->
                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Saved sounds folder" Classes="h2"/>
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Text="{Binding DownloadFolder}" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Content="Change" Margin="8 0 0 0" Click="ChangeDownloadFolder_Click"/>
                                    <Button Grid.Column="2" Content="Open" Margin="8 0 0 0" Click="OpenDownloadFolder_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Hotkeys -->
                        <Border Classes="card">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Hotkeys" Classes="h2"/>
                                    <TextBlock Text="Each sound can also have its own hotkey (right-click a sound)." Classes="sub" FontSize="12"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Text="Play / Pause" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                    <TextBox Grid.Column="1" Name="PlayPauseHotkeyTextBox" Width="160"
                                             Text="{Binding PlayPauseHotkey, Mode=OneWay}" IsReadOnly="True"/>
                                    <Button Grid.Column="2" Content="Change" Margin="8 0 0 0"
                                            Click="SetHotkey_Click" Tag="{Binding #PlayPauseHotkeyTextBox}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Text="Stop" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                    <TextBox Grid.Column="1" Name="StopHotkeyTextBox" Width="160"
                                             Text="{Binding StopHotkey, Mode=OneWay}" IsReadOnly="True"/>
                                    <Button Grid.Column="2" Content="Change" Margin="8 0 0 0"
                                            Click="SetHotkey_Click" Tag="{Binding #StopHotkeyTextBox}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Text="Pause" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                    <TextBox Grid.Column="1" Name="PauseHotkeyTextBox" Width="160"
                                             Text="{Binding PauseHotkey, Mode=OneWay}" IsReadOnly="True"/>
                                    <Button Grid.Column="2" Content="Change" Margin="8 0 0 0"
                                            Click="SetHotkey_Click" Tag="{Binding #PauseHotkeyTextBox}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- VB-Cable help -->
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Game can't hear you / noisy mic?" Classes="h2"/>
                                <TextBlock Classes="sub" FontSize="12"
                                           Text="1. Open Windows sound settings below. On the Playback tab open CABLE Input, on the Recording tab open CABLE Output."/>
                                <TextBlock Classes="sub" FontSize="12"
                                           Text="2. Advanced tab on both: pick the same format, 2 channel, 16 bit, 48000 Hz, and untick both 'Exclusive mode' boxes."/>
                                <TextBlock Classes="sub" FontSize="12"
                                           Text="3. Recording tab: right-click CABLE Output and choose 'Set as Default Communication Device', then restart the game."/>
                                <TextBlock Classes="sub" FontSize="12"
                                           Text="4. In the game pick CABLE Output, then turn the noise gate up until the meter shows 'gated' when you're quiet."/>
                                <Button Click="OpenSoundSettings_Click" HorizontalAlignment="Left" Margin="0 6 0 0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconTune}" Width="14" Height="14"/>
                                        <TextBlock Text="Open Windows sound settings"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= Selected sound panel (Sounds tab only) ================= -->
            <Border Grid.Column="3" Width="320"
                    Background="{StaticResource Surface1Brush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1 0 0 0">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="#SoundsNav.IsChecked"/>
                        <Binding Path="SelectedSound" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                    </MultiBinding>
                </Border.IsVisible>
                <ScrollViewer>
                    <StackPanel Spacing="20" Margin="22 26">
                        <StackPanel Spacing="12">
                            <Border Width="96" Height="96" CornerRadius="16" ClipToBounds="True"
                                    Background="{StaticResource Surface3Brush}" HorizontalAlignment="Left">
                                <Image Source="{Binding SelectedSound.IconPath, Converter={StaticResource UriConverter}}"
                                       Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="SELECTED SOUND" Classes="label"/>
                            <TextBox Text="{Binding SelectedSound.Name, Mode=TwoWay}" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Play controls -->
                        <Grid ColumnDefinitions="*,8,Auto">
                            <Button x:Name="PlayPauseButton" Classes="accent" Click="PlayPauseHandler"
                                    HorizontalAlignment="Stretch" Height="44">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Panel>
                                        <PathIcon x:Name="PlayIcon" Data="{StaticResource IconPlay}"/>
                                        <PathIcon x:Name="PauseIcon" Data="{StaticResource IconPause}" IsVisible="False"/>
                                    </Panel>
                                    <TextBlock x:Name="PlayPauseButtonText" Text="Play" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopButton" Grid.Column="2" Classes="icon" Width="44" Height="44"
                                    Click="StopHandler" IsEnabled="False" ToolTip.Tip="Stop">
                                <PathIcon Data="{StaticResource IconStop}" Width="14" Height="14"/>
                            </Button>
                        </Grid>
                        <CheckBox Content="Loop" IsChecked="{Binding IsLoopingEnabled}"/>

                        <!-- Hotkey -->
                        <Border Classes="card" Padding="14">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="HOTKEY" Classes="label"/>
                                    <TextBlock Text="{Binding SelectedSound.HotkeyText}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Set" Click="SetSoundHotkey_Click"/>
                                <Button Grid.Column="2" Classes="ghost" Content="Clear" Margin="4 0 0 0"
                                        Click="ClearSoundHotkey_Click" IsVisible="{Binding SelectedSound.HasHotkey}"/>
                            </Grid>
                        </Border>

                        <!-- Sliders -->
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="VOLUME" Classes="label"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSound.Volume, StringFormat='{}{0:F0}%'}" Classes="value"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="100" Value="{Binding SelectedSound.Volume, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="BASS" Classes="label"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSound.Bass, StringFormat='{}{0:F0} dB'}" Classes="value"/>
                                </Grid>
                                <Slider Minimum="-20" Maximum="20" Value="{Binding SelectedSound.Bass, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="TREBLE" Classes="label"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSound.Treble, StringFormat='{}{0:F0} dB'}" Classes="value"/>
                                </Grid>
                                <Slider Minimum="-20" Maximum="20" Value="{Binding SelectedSound.Treble, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="PITCH" Classes="label"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSound.Pitch, StringFormat='{}{0:F1}x'}" Classes="value"/>
                                </Grid>
                                <Slider Minimum="0.5" Maximum="2.0" Value="{Binding SelectedSound.Pitch, Mode=TwoWay}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- YouTube clip -->
                        <Border Classes="card" Padding="14" IsVisible="{Binding SelectedSound.IsYouTube}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="YOUTUBE CLIP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                <Grid ColumnDefinitions="*,10,*">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="START" Classes="label"/>
                                        <TextBox Text="{Binding SelectedSound.StartText, Mode=OneWay}" Tag="start"
                                                 LostFocus="ClipTimeBox_LostFocus" Watermark="0:00"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="END" Classes="label"/>
                                        <TextBox Text="{Binding SelectedSound.EndText, Mode=OneWay}" Tag="end"
                                                 LostFocus="ClipTimeBox_LostFocus" Watermark="full"/>
                                    </StackPanel>
                                </Grid>
                                <Button Click="OpenOnYouTube_Click" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconLink}" Width="14" Height="14"/>
                                        <TextBlock Text="Open on YouTube"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="*,8,*">
                            <Button Click="ChangeIconClicked" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconImage}" Width="14" Height="14"/>
                                    <TextBlock Text="Icon"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Click="SaveChangesClicked" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconSave}" Width="14" Height="14"/>
                                    <TextBlock Text="Save"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="StatMessage" Classes="sub" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= Mini player (always reachable) ================= -->
        <Border Grid.Row="1" IsVisible="{Binding PlayerVisible}"
                Background="{StaticResource Surface1Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0 1 0 0"
                Padding="16 10">
            <Grid ColumnDefinitions="300,*,Auto">
                <!-- What's playing -->
                <Button Classes="ghost" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Click="PlayerOpenSource_Click" ToolTip.Tip="Go to where this sound is">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="46" Height="46" CornerRadius="10" ClipToBounds="True"
                                Background="{StaticResource Surface3Brush}">
                            <Panel>
                                <Image Source="{Binding PlayerIconPath, Converter={StaticResource UriConverter}}"
                                       Stretch="UniformToFill"/>
                                <Image Source="{Binding PlayerThumb}" Stretch="UniformToFill"
                                       IsVisible="{Binding PlayerThumb, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12 0 0 0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding PlayerTitle}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding PlayerSubtitle}" FontSize="11" FontWeight="Normal"
                                       Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Controls + seek -->
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MaxWidth="620" Margin="16 0">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Classes="icon small ghost round" Click="PlayerReplay_Click" ToolTip.Tip="Play again from start">
                            <PathIcon Data="{StaticResource IconReplay}" Width="16" Height="16"/>
                        </Button>
                        <Button Classes="icon accent round" Width="38" Height="38" Click="PlayerPlayPause_Click"
                                ToolTip.Tip="Play / pause">
                            <Panel>
                                <PathIcon Data="{StaticResource IconPause}" Width="14" Height="14" IsVisible="{Binding PlayerIsPlaying}"/>
                                <PathIcon Data="{StaticResource IconPlay}" Width="14" Height="14" IsVisible="{Binding !PlayerIsPlaying}"/>
                            </Panel>
                        </Button>
                        <Button Classes="icon small ghost round" Click="PlayerStop_Click" ToolTip.Tip="Stop">
                            <PathIcon Data="{StaticResource IconStop}" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{Binding PlayerElapsedText}" Classes="value" FontSize="11"
                                   MinWidth="40" VerticalAlignment="Center"/>
                        <Slider x:Name="PlayerSeekSlider" Grid.Column="1" Minimum="0" Maximum="1"
                                IsEnabled="{Binding PlayerCanSeek}" Margin="8 -6"/>
                        <TextBlock Grid.Column="2" Text="{Binding PlayerTotalText}" Classes="value" FontSize="11"
                                   MinWidth="40" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Right side -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <CheckBox Content="Loop" IsChecked="{Binding IsLoopingEnabled}"/>
                    <Border Width="1" Height="24" Background="{StaticResource BorderBrush}"/>
                    <PathIcon Data="{StaticResource IconVolume}" Width="16" Height="16"
                              Foreground="{StaticResource MutedBrush}" ToolTip.Tip="How loud you hear sounds"/>
                    <Slider Width="110" Minimum="0" Maximum="100" Value="{Binding MasterSpeakerVolume, Mode=TwoWay}"
                            VerticalAlignment="Center" ToolTip.Tip="How loud you hear sounds (friends' level is in Settings)"/>
                    <Button Classes="icon small ghost round" Click="PlayerClose_Click" ToolTip.Tip="Stop and hide">
                        <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Status bar ================= -->
        <Border x:Name="BottomContainer" Grid.Row="2"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0 1 0 0"
                Padding="16 0" Height="34">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatoMessage" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                <StackPanel x:Name="ProgressBarContainer" Grid.Column="1" Orientation="Horizontal"
                            Spacing="12" VerticalAlignment="Center" IsVisible="False">
                    <ProgressBar Width="160" Height="4" MinHeight="4" IsIndeterminate="True"/>
                    <TextBlock x:Name="ProgressStatus" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="InstallationMessage" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="StatusMessage" FontSize="12" Foreground="{StaticResource MutedBrush}" IsVisible="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= VB-Cable install prompt ================= -->
        <Border x:Name="InstallationPanel" Grid.RowSpan="3"
                Classes="card" Padding="28" Width="460"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                ZIndex="100" IsVisible="False"
                BoxShadow="0 20 60 0 #A0000000">
            <StackPanel Spacing="16">
                <TextBlock Text="Install VB-Cable" Classes="h2" FontSize="18"/>
                <TextBlock x:Name="InstallationMessageT1" Classes="sub"
                           Text="VB-Cable is the free virtual mic that lets your friends hear the sounds. Install it once, then restart your PC."/>
                <TextBlock x:Name="InstallationMessageT" Classes="sub"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Content="Later" Click="OnExitClicked"/>
                    <Button Content="Install now" Classes="accent" Click="OnInstallClicked"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
