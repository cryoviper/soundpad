<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.4.0</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <Product>Boobies Soundpad</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>Boobies Soundpad</AssemblyTitle>
    <Description>Soundboard + live YouTube player for your virtual mic. Based on BoomBx by sardeq.</Description>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>BoomBx</RootNamespace>
    
    <OutputType>WinExe</OutputType>
    <AssemblyName>BoobiesSoundpad</AssemblyName>
    <OutputName>BoobiesSoundpad</OutputName>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <DisableMonoConsole>true</DisableMonoConsole>
    <AvaloniaDisableConsoleLifetime>true</AvaloniaDisableConsoleLifetime>
    <AvaloniaUseWindowsDesktopSdk>true</AvaloniaUseWindowsDesktopSdk>
    
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Sounds\vineboom.mp3" />
    <EmbeddedResource Include="InstallScripts\InstallVBCable.bat" />
  </ItemGroup>

  <!-- Updated eSpeak embedding configuration -->
  <ItemGroup>
    <!-- Include all files in the espeak directory as embedded resources -->
    <EmbeddedResource Include="espeak\Windows\**\*">
      <LogicalName>espeak.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**">
      <Pack>true</Pack>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </AvaloniaResource>

    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="MessageBox.Avalonia" Version="3.2.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SharpHook" Version="5.4.0" />
    <PackageReference Include="System.Speech" Version="9.0.5" />
    <!-- YouTube search + streams. Floating 6.x so a rebuild picks up fixes when YouTube changes things. -->
    <PackageReference Include="YoutubeExplode" Version="6.*" />
  </ItemGroup>

</Project>